#!/usr/bin/env bash
# Extract one task's full text from tasks.md into a file the
# implementer reads in one call, so the task text never has to be pasted
# through the controller's context.
#
# Usage: task-brief TASKS_FILE TASK_NUMBER [OUTFILE]
# Default OUTFILE: <plan-dir>/task-<N>-brief.md
#
# MyCode adaptation: tasks are in independent tasks.md file (not plan file)
set -euo pipefail

if [ $# -lt 2 ] || [ $# -gt 3 ]; then
  echo "usage: task-brief TASKS_FILE TASK_NUMBER [OUTFILE]" >&2
  exit 2
fi

tasks_file=$1
n=$2
[ -f "$tasks_file" ] || { echo "no such tasks file: $tasks_file" >&2; exit 2; }

if [ $# -eq 3 ]; then
  out=$3
else
  plan_dir=$(dirname "$tasks_file")
  out="$plan_dir/task-${n}-brief.md"
fi

awk -v n="$n" '
  /^```/ { infence = !infence }
  !infence && /^#+[ \t]+Task[ \t]+[0-9]+/ {
    intask = ($0 ~ ("^#+[ \t]+Task[ \t]+" n "([^0-9]|$)"))
  }
  intask { print }
' "$tasks_file" > "$out"

if [ ! -s "$out" ]; then
  echo "task ${n} not found in ${tasks_file} (no heading matching 'Task ${n}')" >&2
  exit 3
fi

echo "wrote ${out}: $(wc -l < "$out" | tr -d ' ') lines"
