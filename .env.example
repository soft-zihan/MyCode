# MyCode local environment — copy to .env and fill in.
#   cp .env.example .env
# .env is gitignored; start.sh loads it automatically (set -a) before launching
# the backend. Every value below is the effective default, so an empty .env works.

# ── Observability (Langfuse) ────────────────────────────────────────────────
# Tracing master switch. Truthy values: 1 / true / yes / on.
# start.sh defaults this to 1, but running the backend directly defaults to off.
MYCODE_TRACING=1

# Both keys are required — with either missing, tracing initialisation raises and
# is caught, so the service still runs but produces local logs only.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ── Storage ─────────────────────────────────────────────────────────────────
# Session event backend: "sqlite" selects SQLite, anything else falls back to jsonl.
MYCODE_SESSION_BACKEND=jsonl

# ── Network exposure ────────────────────────────────────────────────────────
# Backend bind address. Empty means 127.0.0.1 (local only) — the safe default.
# Remote access is recommended over an SSH tunnel instead of exposing the port:
#   ssh -L 5555:localhost:5555 -L 8090:localhost:8090 user@server
MYCODE_HOST=

# Bearer token for /api and the WS handshake. Required if you set MYCODE_HOST
# to a non-loopback address; without it anyone who can reach the port can drive
# the agent.
MYCODE_AUTH_TOKEN=

# ── Model routing ───────────────────────────────────────────────────────────
# Endpoint id or bare model name used for side queries (memory recall, context
# folding, skill evolution). Unset means the primary endpoint is reused.
# Normally configured via routing.side in ~/.my-code/config.json instead.
MYCODE_SIDE_MODEL=

# ── Skill evolution ─────────────────────────────────────────────────────────
# Auto-activate an eval champion skill. Truthy: 1 / true / yes.
# Defaults to OFF (observation mode) — must be enabled explicitly.
MYCODE_SKILL_AUTO_ACTIVATE=

# Online skill self-evolution. Enabled unless set to 0 / false / no / off.
MYCODE_AUTO_SKILL_EVOLUTION=1
