{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": ["@playwright/mcp@latest"]
    },
    "code-review-graph": {
      "command": "code-review-graph",
      "args": [
        "serve",
        "--tools",
        "build_or_update_graph_tool,query_graph_tool,semantic_search_nodes_tool,get_impact_radius_tool,detect_changes_tool,list_graph_stats_tool,get_minimal_context_tool"
      ]
    }
  }
}
